{
  "name": "@naadan/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=./prisma/schema.prisma",
    "start": "tsx src/server.ts",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "nodemailer": "^8.0.11",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "prisma": "^6.12.0",
    "typescript": "^5.0.0"
  }
}
